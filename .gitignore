# OS and editors
.DS_Store
*.swp
.idea/
.vscode/

# Secrets and local configuration
.env
.env.*
!.env.example
tokens.json
*.pem
*.key

# Logs
*.log

# Node, Next.js and Cloudflare
node_modules/
.next/
out/
.open-next/
.wrangler/
dist/
coverage/
*.tsbuildinfo
next-env.d.ts

# Local working notes
/notes/

# The web server's own notes of the transactions it sent
.pari/

# Local build brief for the coding agent (would load as the judges' Claude Code instructions)
/CLAUDE.md

# Rust build output (NEAR contract and enclave)
target/

# NEAR testnet keys written by near/scripts/setup-testnet.ts
/near/.keys/

# Logs of deals played on NEAR testnet, and the proof each run leaves. The two
# recorded runs the README names are kept: the leak test and the proof check
# read the newer one by default.
/near/runs/*
!/near/runs/northwind-13.json
!/near/runs/northwind-14.json
/near/proofs/*
!/near/proofs/northwind-13.json
!/near/proofs/northwind-14.json
