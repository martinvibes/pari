-- | Seeds a running ledger with the demo deal the web app drives.
--
-- Run `sandbox` against a local ledger to allocate fresh parties; it writes
-- the cast to the output file for the web app. On DevNet the deal is seeded
-- in Canton Coin by `web/scripts/seed-coin.ts` instead.
module Pari.Demo
  ( sandbox
  , scale
  ) where

import DA.Date (Month(..), date)
import DA.Foldable (forA_)
import DA.Text qualified as Text
import DA.Time (convertRelTimeToMicroseconds, subTime, time)
import Daml.Script

import Pari.Disclosure
import Pari.Facility
import Pari.Test.Scale (Timings, atScale, wide, wideSyndicate)
import Pari.Test.Setup

-- | A new deal with new parties, so the same ledger can be seeded again for
-- a fresh start. Party ids are tagged with the time of the run.
sandbox : Script Cast
sandbox = do
  tag <- runTag
  cast <- allocateCastWith \name -> allocatePartyByHint (PartyIdHint (name <> "-" <> tag))
  seedWith cast

-- | The scale test's deal on a live ledger, with new parties: a hundred
-- lenders close, are paid interest and are prepaid, each step checked and
-- timed by the wall clock. `make scale`.
scale : Script Timings
scale = do
  tag <- runTag
  let named name = allocatePartyByHint (PartyIdHint (name <> "-" <> tag))
  env <- allocateCastWith named >>= prepare mempty
  wideSyndicate env named wide >>= atScale env

-- | Seconds since the epoch, in base 36.
runTag : Script Text
runTag = do
  now <- getTime
  pure (base36 (convertRelTimeToMicroseconds (subTime now (time (date 1970 Jan 1) 0 0 0)) / 1_000_000))

base36 : Int -> Text
base36 n
  | n < 36 = digit
  | otherwise = base36 (n / 36) <> digit
  where digit = Text.substring (n % 36) 1 "0123456789abcdefghijklmnopqrstuvwxyz"

-- | Leaves the Northwind deal closed with its first period's rate fixed and
-- the cast's auditor, if any, appointed before closing; cash with the
-- borrower and both buyers, each lender's information election, and two
-- borrower documents not yet shared. Every later step (interest, trades, prepayment,
-- document distribution) is driven from the web app.
seedWith : Cast -> Script Cast
seedWith cast = do
  env <- prepare mempty cast
  (proposed, commitments) <- syndicateFacility env
  audited <- case cast.auditor of
    None -> pure proposed
    Some auditor -> submit (actAs cast.borrower) $ exerciseCmd proposed Facility_AppointAuditor with
      newAuditor = auditor
  closed <- submit (actAs cast.agent) $ exerciseCmd audited Facility_Close with commitments
  _ <- submit (actAs cast.agent) $ exerciseCmd closed Facility_FixRate with
    baseRate = sofr
    periodEnd = firstPeriodEnd
  forA_ [(cast.alder, PrivateSide), (cast.birch, PublicSide), (cast.cedar, PublicSide)] \(lender, side) ->
    submit (actAs lender) $ createCmd InfoElection with
      lender
      agent = cast.agent
      facilityId = dealId
      side
  forA_ documents \(docId, title, mnpi, sha256) ->
    submit (actAs cast.borrower) $ createCmd Document with
      borrower = cast.borrower
      agent = cast.agent
      facilityId = dealId
      docId
      title
      uri = "https://dataroom.northwind.example/" <> docId
      sha256
      mnpi
  pure cast

-- | Placeholder data-room documents, each identified by the SHA-256 of its title.
documents : [(Text, Text, Bool, Text)]
documents =
  [ ( "credit-agreement"
    , "Northwind Logistics credit agreement"
    , False
    , "3955dd896f2d12fa22a2e3103f821be8a08d3d808e285ca500a35990bc91854e" )
  , ( "q3-2026-management-accounts"
    , "Northwind Logistics Q3 2026 management accounts"
    , True
    , "02c3a6e84c481110fb8f23dd9a9d9425bbf678f25233854ae5b17b1aa1bbccea" )
  ]
