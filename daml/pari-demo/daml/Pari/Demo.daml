-- | Seeds a running ledger with the demo deal the web app drives.
--
-- Run `sandbox` against a local ledger to allocate fresh parties, or `seed`
-- with an input file of existing parties (e.g. ones created on DevNet). Both
-- write the cast to the output file for the web app.
module Pari.Demo
  ( sandbox
  , Seed(..)
  , seed
  ) where

import DA.Date (Month(..), date)
import DA.Foldable (forA_)
import DA.Text qualified as Text
import DA.Time (convertRelTimeToMicroseconds, subTime, time)
import Daml.Script

import Pari.Disclosure
import Pari.Test.Setup

-- | A new deal with new parties, so the same ledger can be seeded again for
-- a fresh start. Party ids are tagged with the time of the run.
sandbox : Script Cast
sandbox = do
  tag <- runTag
  cast <- allocateCastWith \name -> allocatePartyByHint (PartyIdHint (name <> "-" <> tag))
  seedWith mempty cast

-- | Seconds since the epoch, in base 36.
runTag : Script Text
runTag = do
  now <- getTime
  pure (base36 (convertRelTimeToMicroseconds (subTime now (time (date 1970 Jan 1) 0 0 0)) / 1_000_000))

base36 : Int -> Text
base36 n
  | n < 36 = digit
  | otherwise = base36 (n / 36) <> digit
  where digit = Text.substring (n % 36) 1 "0123456789abcdefghijklmnopqrstuvwxyz"

-- | `seed`'s input: the parties, and the ids of the packages the deal runs.
-- A shared participant may vet a later version of a package this deal uses,
-- uploaded by someone else, and would otherwise prefer it.
data Seed = Seed with
    cast : Cast
    packages : [Text]

-- | The demo deal on existing parties, every submission pinned to `packages`.
seed : Seed -> Script Cast
seed Seed{..} = seedWith (packagePreference (map PackageId packages)) cast

-- | Leaves the Northwind deal closed with its first period's rate fixed, cash
-- with the borrower and both buyers, each lender's information election, and
-- two borrower documents not yet shared. Every later step (interest, trades,
-- prepayment, document distribution) is driven from the web app.
seedWith : SubmitOptions -> Cast -> Script Cast
seedWith pin cast = do
  env <- prepare pin cast
  _ <- activeFacility env
  forA_ [(cast.alder, PrivateSide), (cast.birch, PublicSide), (cast.cedar, PublicSide)] \(lender, side) ->
    submit (actAs lender <> pin) $ createCmd InfoElection with
      lender
      agent = cast.agent
      facilityId = dealId
      side
  forA_ documents \(docId, title, mnpi, sha256) ->
    submit (actAs cast.borrower <> pin) $ createCmd Document with
      borrower = cast.borrower
      agent = cast.agent
      facilityId = dealId
      docId
      title
      uri = "https://dataroom.northwind.example/" <> docId
      sha256
      mnpi
  pure cast

-- | Placeholder data-room documents, each identified by the SHA-256 of its title.
documents : [(Text, Text, Bool, Text)]
documents =
  [ ( "credit-agreement"
    , "Northwind Logistics credit agreement"
    , False
    , "3955dd896f2d12fa22a2e3103f821be8a08d3d808e285ca500a35990bc91854e" )
  , ( "q3-2026-management-accounts"
    , "Northwind Logistics Q3 2026 management accounts"
    , True
    , "02c3a6e84c481110fb8f23dd9a9d9425bbf678f25233854ae5b17b1aa1bbccea" )
  ]
