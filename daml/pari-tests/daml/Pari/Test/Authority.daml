-- | Authority: the agent administers the loan but can never create, move or
-- shrink a lender's position, or move anyone's tokens, on its own.
module Pari.Test.Authority where

import DA.Assert ((===))
import DA.Foldable (forA_)
import DA.Optional (fromSome)
import DA.Time (time)
import Daml.Script

import Splice.Api.Token.AllocationRequestV1 (AllocationRequest, AllocationRequest_Withdraw(..))
import Splice.Api.Token.AllocationV1 (Allocation_ExecuteTransfer(..), Allocation_Withdraw(..))

import Pari.Facility
import Pari.Position
import Pari.Screening
import Pari.Settlement (mkLeg)
import Pari.Trade (tradeLegId)

import Pari.Test.Setup
import Pari.Test.Trading (agreeTrade, settleTrade)

test_agent_cannot_create_a_position : Script ()
test_agent_cannot_create_a_position = do
  env <- setup
  _ <- closeFacility env
  submitMustFail env.agent $ createCmd Position with
    agent = env.agent
    lender = env.buyer
    facilityId = dealId
    principal = 10_000_000.0

test_agent_cannot_move_a_position : Script ()
test_agent_cannot_move_a_position = do
  env <- setup
  _ <- closeFacility env
  (alderPosition, _) <- positionOf env.alder
  submitMustFail env.agent $ exerciseCmd alderPosition Position_Reduce with
    amount = 50_000_000.0; retain = False
  submitMustFail env.agent $ exerciseCmd alderPosition Archive
  (_, alder) <- positionOf env.alder
  alder.principal === 50_000_000.0

test_lender_cannot_inflate_its_position : Script ()
test_lender_cannot_inflate_its_position = do
  env <- setup
  _ <- closeFacility env
  (alderPosition, _) <- positionOf env.alder
  submitMustFail env.alder $ exerciseCmd alderPosition Position_Increase with
    amount = 1_000_000.0

test_agent_cannot_pay_out_without_the_borrower : Script ()
test_agent_cannot_pay_out_without_the_borrower = do
  env <- setup
  facility <- activeFacility env
  setTime (time firstPeriodEnd 9 0 0)
  (_, requestCid) <- requestInterest env facility
  request <- fromSome <$> queryContractId env.borrower requestCid
  [(legId, leg)] <- pure (filter (\(_, l) -> l.receiver == env.alder) (legsOf request))
  (allocationCid, extraArgs) <- allocate env request.settlement legId leg
  (position, _) <- positionOf leg.receiver

  -- The allocation needs the executor, sender and receiver together.
  submitMustFail env.agent $ exerciseCmd allocationCid Allocation_ExecuteTransfer with extraArgs
  -- And the agent cannot drive a position's settlement without the borrower.
  submitMustFail env.agent $ exerciseCmd position Position_Settle with
    borrower = env.borrower
    expectedPrincipal = 50_000_000.0
    principalReduction = 0.0
    retain = True
    kind = request.kind
    due = leg.amount
    settlement = request.settlement
    legId
    leg
    allocation = (allocationCid, extraArgs)

-- | The agent executes every closing, payment and trade, yet never holds a
-- cent: money moves straight from the payer's holdings to the payee's.
test_agent_never_holds_the_money : Script ()
test_agent_never_holds_the_money = do
  env <- setup
  let agentHoldsNothing = do
        cash <- holdingsOf env env.agent
        cash === []
  facility <- activeFacility env
  agentHoldsNothing
  setTime (time midPeriod 9 0 0)
  ticket <- agreeTrade env env.alder env.buyer 10_000_000.0 0.995
  settled <- settleTrade env facility ticket
  agentHoldsNothing
  setTime (time firstPeriodEnd 9 0 0)
  (facility, _) <- requestInterest env settled.facilityCid
  _ <- pay env facility 1.0
  agentHoldsNothing

-- | Calling off a payment moves nothing: the borrower's funded legs stay its
-- own until it takes them back, and the agent can simply ask again.
test_cancelled_request_returns_the_borrowers_cash : Script ()
test_cancelled_request_returns_the_borrowers_cash = do
  env <- setup
  facility <- activeFacility env
  setTime (time firstPeriodEnd 9 0 0)
  before <- balanceOf env env.borrower
  (facility, requestCid) <- requestInterest env facility
  request <- fromSome <$> queryContractId env.borrower requestCid
  allocations <- forA (legsOf request) \(legId, leg) -> allocate env request.settlement legId leg
  funded <- balanceOf env env.borrower
  funded === before - sum (map ((.amount) . snd) (legsOf request))

  facility <- submit env.agent $ exerciseCmd facility Facility_CancelRequest
  forA_ allocations \(allocationCid, extraArgs) ->
    submitMustFail env.agent $ exerciseCmd allocationCid Allocation_ExecuteTransfer with extraArgs
  forA_ allocations \(allocationCid, extraArgs) ->
    submit env.borrower $ exerciseCmd allocationCid Allocation_Withdraw with extraArgs
  after <- balanceOf env env.borrower
  after === before
  _ <- requestInterest env facility
  pure ()

-- | The agent can decline a trade it will not settle, but that moves nothing
-- either: the buyer withdraws its own cash, in full.
test_declined_trade_returns_the_buyers_cash : Script ()
test_declined_trade_returns_the_buyers_cash = do
  env <- setup
  _ <- activeFacility env
  setTime (time midPeriod 9 0 0)
  ticketCid <- agreeTrade env env.alder env.rival 10_000_000.0 0.995
  ticket <- fromSome <$> queryContractId env.rival ticketCid
  (allocationCid, extraArgs) <- allocate env ticket.settlement tradeLegId (mkLeg env.rival env.alder ticket.cash env.usd)

  submit env.agent $ exerciseCmd (toInterfaceContractId @AllocationRequest ticketCid) AllocationRequest_Withdraw with
    extraArgs = noExtraArgs
  submitMustFail env.agent $ exerciseCmd allocationCid Allocation_ExecuteTransfer with extraArgs
  submit env.rival $ exerciseCmd allocationCid Allocation_Withdraw with extraArgs
  rivalCash <- balanceOf env env.rival
  rivalCash === 20_000_000.0
  (_, alder) <- positionOf env.alder
  alder.principal === 50_000_000.0

test_agent_cannot_clear_a_buyer_itself : Script ()
test_agent_cannot_clear_a_buyer_itself = do
  env <- setup
  _ <- activeFacility env
  -- A clearance must be co-signed by the borrower, via the DQ list.
  now <- getTime
  submitMustFail env.agent $ createCmd ScreeningResult with
    borrower = env.borrower
    agent = env.agent
    facilityId = dealId
    candidate = env.rival
    cleared = True
    screenedAt = now

test_only_the_borrower_edits_the_dq_list : Script ()
test_only_the_borrower_edits_the_dq_list = do
  env <- setup
  submitMustFail env.agent $ exerciseCmd env.dqList DqList_Update with newList = mempty
  pure ()

